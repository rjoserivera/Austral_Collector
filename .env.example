# ============================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNO (.env)
# Wiki Kreative Gen 15.5
# ============================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a ".env"
# 2. Rellena los valores según tu entorno
# 3. NUNCA subas el archivo .env real a Git (ya está en .gitignore)
# ============================================================

# --- CONFIGURACIÓN DE ENTORNO ---
# Usar 'dev' para desarrollo local (XAMPP) o 'prod' para producción (cPanel)
ENVIRONMENT=dev

DEV_AUTH_DB_HOST=localhost
DEV_AUTH_DB_NAME=
DEV_AUTH_DB_USER=root
DEV_AUTH_DB_PASS=
DEV_AUTH_DB_PORT=3306

PROD_AUTH_DB_HOST=localhost
PROD_AUTH_DB_NAME=
PROD_AUTH_DB_USER=
PROD_AUTH_DB_PASS=
PROD_AUTH_DB_PORT=3306

