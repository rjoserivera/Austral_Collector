{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Austral Collector",
  "locale": "es",
  "colors": {
    "primary": "#C9A84C",
    "light": "#E8CD82",
    "dark": "#A07830"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentación",
        "groups": [
          {
            "group": "Primeros pasos",
            "pages": [
              "index",
              "instalacion",
              "arquitectura",
              "flowchart"
            ]
          },
          {
            "group": "Panel de Administración",
            "pages": [
              "admin/panel"
            ]
          }
        ]
      },
      {
        "tab": "Referencia de API",
        "groups": [
          {
            "group": "API REST",
            "pages": [
              "api/introduccion",
              "api/autenticacion",
              "api/figuras"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Comunidad",
          "href": "https://www.australcollector.com",
          "icon": "users"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/tu-usuario/austral-collector",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Soporte",
        "href": "mailto:contacto@australcollector.com"
      }
    ]
  },
  "footer": {
    "socials": {
      "facebook": "https://www.facebook.com/AustralCollector",
      "instagram": "https://www.instagram.com/austral.collector",
      "youtube": "https://www.youtube.com/@AustralCollector"
    }
  }
}
